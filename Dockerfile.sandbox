# ================================
# Untrusted-content sandbox (docs/10_rfcs/UNTRUSTED_CONTENT_SANDBOX_RFC.md §4.2, §4.3, §4.11)
# ================================
# Target `render` (S1 + S2): Python + Node + the `docx` npm package, plus chrome-headless-shell (Puppeteer) and fonts for
# the `render.pdf` / `render.png` ops.
# Target `light` (P1): Python + the drive parser's libraries, for the `parse.*` ops. No node, no npm, no media tools
# (those arrive with S5). Always build with an explicit `--target`.
# The image holds nothing: COPY is an explicit allowlist (never `.`), computed from the static import closure of
# sandbox_main.py and pinned by tests/unit/test_dockerfile_sandbox.py. No .env, key file, Firestore, Secret Manager or
# Storage client. The server runs as root (G12): only the engine children drop to the unprivileged user below.
FROM python:3.11-slim AS render

# Streams logs at once; and no .pyc is ever written (an engine uid must not be able to plant bytecode the server loads).
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# nodejs/npm — the DOCX engine child runs LLM-generated docx scripts under node. The fonts are the Playwright Debian list
# (parity with what widgets and PDFs render with today: Latin, Cyrillic, CJK, Thai, emoji), minus xvfb.
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm ca-certificates \
        fonts-noto-color-emoji fonts-unifont libfontconfig1 libfreetype6 xfonts-scalable fonts-liberation \
        fonts-ipafont-gothic fonts-wqy-zenhei fonts-tlwg-loma-otf fonts-freefont-ttf \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-sandbox.txt .
RUN pip install --no-cache-dir -r requirements-sandbox.txt

COPY docx_generator/package.json docx_generator/
RUN cd docx_generator && npm install --omit=dev

# The HTML render engine: puppeteer (locked by package-lock.json, `npm ci`) drives chrome-headless-shell ONLY (no full
# Chrome). `puppeteer browsers install` with no version installs the shell revision the INSTALLED puppeteer expects, into
# PUPPETEER_CACHE_DIR, so the two agree by construction. `--install-deps` apt-installs the Chromium runtime libraries. The browser lands in /opt/puppeteer, root-owned and closed to the engine user (below).
ENV PUPPETEER_CACHE_DIR=/opt/puppeteer \
    PUPPETEER_SKIP_DOWNLOAD=true
COPY pdf_generator/package.json pdf_generator/package-lock.json pdf_generator/
COPY pdf_generator/render_html.js pdf_generator/
RUN cd pdf_generator && npm ci --omit=dev \
    && apt-get update \
    && npx puppeteer browsers install chrome-headless-shell --install-deps \
    && rm -rf /var/lib/apt/lists/* /root/.npm

# Engine children run as this user (DEFAULT_ENGINE_USER in src/composition/sandbox_setup.py): system, no home, no shell.
RUN useradd --system --user-group --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin sandboxengine

# The code: one COPY per directory, files named one by one.
COPY sandbox_main.py /app/
COPY src/adapters/sandbox_engine/__init__.py src/adapters/sandbox_engine/child_launcher.py src/adapters/sandbox_engine/docx_render_engine.py src/adapters/sandbox_engine/html_render_engine.py src/adapters/sandbox_engine/limits_exec.py src/adapters/sandbox_engine/parse_engine.py src/adapters/sandbox_engine/render_docx_child.py src/adapters/sandbox_engine/render_html_child.py /app/src/adapters/sandbox_engine/
COPY src/composition/__init__.py src/composition/sandbox_callers.py src/composition/sandbox_setup.py /app/src/composition/
COPY src/domain/docx_script_prelude.py src/domain/memory_telemetry.py src/domain/sandbox_contract.py src/domain/sandbox_docx_frame.py src/domain/sandbox_parse_result.py src/domain/sandbox_png_frame.py src/domain/sandbox_startup_check.py src/domain/sandbox_windows_frame.py /app/src/domain/
COPY src/utils/logfire_redacting_exporter.py src/utils/logger.py src/utils/logging_context.py src/utils/memory_scope.py src/utils/telemetry.py /app/src/utils/
COPY src/web/sandbox_app.py src/web/sandbox_caller_gate.py src/web/sandbox_recycler.py src/web/sandbox_supervisor.py src/web/sandbox_unconfigured_app.py src/web/worker_oidc_verifier.py /app/src/web/

# /work: the mount point of the size-limited in-memory volume (Cloud Run gen2); the server creates per-request
# directories there and hands each to the engine uid. /tmp is closed to everyone but root (the server's uid): a world-writable
# /tmp would let the engine write unbounded data to instance memory outside RLIMIT_AS (the child's TMPDIR is its workdir).
# Cloud Run mounts its own world-writable /tmp and /dev/shm over the image's, so the supervisor closes both at start
# (close_shared_temp_dirs in src/composition/sandbox_setup.py); this chmod still covers a local docker run.
RUN mkdir -p /work && chmod 711 /work && chown root:root /tmp && chmod 0700 /tmp

# Nothing the service loads may be writable by the engine user: the app tree belongs to root and is closed to group and
# other (no .pyc is written; an existing __pycache__ would still be read), and the build fails on any world-writable
# file or directory under /app (node_modules aside) or in site-packages.
RUN chown -R root:root /app /opt/puppeteer && chmod -R go-w /app /opt/puppeteer \
    && find /app -name __pycache__ -type d -prune -exec rm -rf {} + \
    && if find /app /opt/puppeteer /usr/local/lib/python3.11/site-packages -path '*/node_modules' -prune -o \
        -perm -o+w ! -type l -print | grep -q .; then \
      echo "world-writable files under /app, /opt/puppeteer or site-packages: the engine user could rewrite them" >&2; \
      exit 1; \
    fi

# Exec form: sandbox_main.py is PID 1 and reaps orphaned grandchildren.
CMD ["python", "sandbox_main.py"]

# ================================
# Target `light` (plan P1): the parse family. The same service, started with SANDBOX_SERVICE=light, runs the drive
# parser's child under the sandbox launcher. COPY = the closure of sandbox_main.py plus the drive child's closure plus
# parse_child.py, file by file (tests/unit/test_sandbox_light_image.py). Same engine user, work volume and root-owned tree.
# ================================
FROM python:3.11-slim AS light

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SANDBOX_SERVICE=light

WORKDIR /app

COPY requirements-sandbox-light.txt .
RUN pip install --no-cache-dir -r requirements-sandbox-light.txt

RUN useradd --system --user-group --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin sandboxengine

COPY sandbox_main.py /app/
COPY src/adapters/drive_parser/__init__.py src/adapters/drive_parser/capture.py src/adapters/drive_parser/child.py src/adapters/drive_parser/epub_package.py src/adapters/drive_parser/html_text.py src/adapters/drive_parser/media.py src/adapters/drive_parser/readers.py /app/src/adapters/drive_parser/
COPY src/adapters/sandbox_engine/__init__.py src/adapters/sandbox_engine/child_launcher.py src/adapters/sandbox_engine/docx_render_engine.py src/adapters/sandbox_engine/html_render_engine.py src/adapters/sandbox_engine/limits_exec.py src/adapters/sandbox_engine/parse_child.py src/adapters/sandbox_engine/parse_engine.py src/adapters/sandbox_engine/render_docx_child.py src/adapters/sandbox_engine/render_html_child.py /app/src/adapters/sandbox_engine/
COPY src/composition/__init__.py src/composition/sandbox_callers.py src/composition/sandbox_setup.py /app/src/composition/
COPY src/domain/connection_scope.py src/domain/document_extraction.py src/domain/document_limits.py src/domain/docx_script_prelude.py src/domain/drive_capture.py src/domain/drive_content_identity.py src/domain/drive_enrichment.py src/domain/drive_extraction.py src/domain/drive_index.py src/domain/drive_index_params.py src/domain/drive_media_facts.py src/domain/drive_note_check.py src/domain/memory_telemetry.py src/domain/sandbox_contract.py src/domain/sandbox_docx_frame.py src/domain/sandbox_parse_result.py src/domain/sandbox_png_frame.py src/domain/sandbox_startup_check.py src/domain/sandbox_windows_frame.py src/domain/text_data_uris.py /app/src/domain/
COPY src/utils/document_hardening.py src/utils/logfire_redacting_exporter.py src/utils/logger.py src/utils/logging_context.py src/utils/memory_scope.py src/utils/telemetry.py /app/src/utils/
COPY src/web/sandbox_app.py src/web/sandbox_caller_gate.py src/web/sandbox_recycler.py src/web/sandbox_supervisor.py src/web/sandbox_unconfigured_app.py src/web/worker_oidc_verifier.py /app/src/web/

RUN mkdir -p /work && chmod 711 /work && chown root:root /tmp && chmod 0700 /tmp

RUN chown -R root:root /app && chmod -R go-w /app \
    && find /app -name __pycache__ -type d -prune -exec rm -rf {} + \
    && if find /app /usr/local/lib/python3.11/site-packages -perm -o+w ! -type l -print | grep -q .; then \
      echo "world-writable files under /app or site-packages: the engine user could rewrite them" >&2; \
      exit 1; \
    fi

CMD ["python", "sandbox_main.py"]
