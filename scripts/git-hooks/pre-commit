#!/bin/bash
# Pre-commit hook: block commits with sensitive data
#
# Checks for:
# 1. Sensitive keywords in commit message (privacy, breach, leak, PII, etc.)
# 2. Real bank names from lists/real-banks.txt
# 3. Real company names from lists/real-companies.txt
# 4. Real-world data patterns (IBAN, VIN, credit cards, tracking numbers)
# 5. Other PII (phone numbers, excessive decimal patterns)

set -e

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel)"
LISTS_DIR="${HOOK_DIR}/lists"

# Color output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

FOUND_ISSUES=0

# Check if this is a merge commit (skip some checks)
IS_MERGE=0
if git rev-parse MERGE_HEAD &>/dev/null; then
    IS_MERGE=1
fi

# Helper: print error
error() {
    echo -e "${RED}✗ COMMIT BLOCKED:${NC} $1"
    FOUND_ISSUES=1
}

warn() {
    echo -e "${YELLOW}⚠ WARNING:${NC} $1"
}

success() {
    echo -e "${GREEN}✓${NC} $1"
}

# ============================================================================
# 1. Check commit message for sensitive keywords
# ============================================================================

if [ $IS_MERGE -eq 0 ]; then
    COMMIT_MSG=$(cat "$1" 2>/dev/null || echo "")

    # Sensitive keywords that reveal a leak/privacy incident
    SENSITIVE_KEYWORDS=(
        "privacy scrub"
        "privacy cleanup"
        "real data"
        "real bank"
        "real company"
        "real name"
        "real address"
        "breach"
        "data leak"
        "pii"
        "personally identifiable"
        "confidential data"
        "remove.*owner"
        "remove.*personal"
        "remove.*health"
        "remove.*medical"
        "remove.*bank"
        "replace.*owner"
        "replace.*personal"
        "sanitize.*owner"
        "scrub.*data"
        "scrub.*owner"
    )

    for keyword in "${SENSITIVE_KEYWORDS[@]}"; do
        if echo "$COMMIT_MSG" | grep -qi "$keyword"; then
            error "Commit message contains sensitive keyword: '$keyword'"
            echo "  Message: ${COMMIT_MSG:0:80}..."
            echo ""
            echo "  Use generic language instead:"
            echo "    ✗ 'privacy scrub', 'remove real data', 'replace owner personal data'"
            echo "    ✓ 'standardize fixtures', 'update content', 'refactor data'"
        fi
    done
fi

# ============================================================================
# 2. Check diff for real bank names
# ============================================================================

if [ -f "${LISTS_DIR}/real-banks.txt" ]; then
    BANKS=$(grep -v '^#' "${LISTS_DIR}/real-banks.txt" | grep -v '^$')

    ADDED_FILES=$(git diff-index --cached --name-only HEAD 2>/dev/null | grep -v '^D' || echo "")

    while IFS= read -r bank; do
        if echo "$ADDED_FILES" | xargs -r git diff-index --cached -p HEAD -- 2>/dev/null | \
           grep -qi "^[+-].*\b${bank}\b"; then

            # Check if it's in an allowed file/phrase
            IS_ALLOWED=0

            while IFS= read -r pattern; do
                if [ -z "$pattern" ]; then continue; fi
                if git diff-index --cached -p HEAD -- | grep "^[+-]" | grep -qi "$pattern"; then
                    IS_ALLOWED=1
                    break
                fi
            done < <(grep -v '^#' "${LISTS_DIR}/allowed-phrases.txt" 2>/dev/null || echo "")

            if [ $IS_ALLOWED -eq 0 ]; then
                error "Real bank name found in diff: '$bank'"
                error "  Bank names should only appear in documentation/examples (allowed-phrases.txt)"
            fi
        fi
    done <<< "$BANKS"
fi

# ============================================================================
# 3. Check diff for real company names
# ============================================================================

if [ -f "${LISTS_DIR}/real-companies.txt" ]; then
    COMPANIES=$(grep -v '^#' "${LISTS_DIR}/real-companies.txt" | grep -v '^$')

    while IFS= read -r company; do
        if [ -z "$company" ]; then continue; fi
        # Escape special regex chars in company name
        ESCAPED_COMPANY=$(printf '%s\n' "$company" | sed 's/[[\.*^$/]/\\&/g')

        if git diff-index --cached -p HEAD -- 2>/dev/null | \
           grep -qi "^[+-].*\b${ESCAPED_COMPANY}\b"; then

            IS_ALLOWED=0

            # Check if it's in an allowed file
            while IFS= read -r file_pattern; do
                [ -z "$file_pattern" ] && continue
                if git diff-index --cached --name-only HEAD -- | grep -qi "$file_pattern"; then
                    IS_ALLOWED=1
                    break
                fi
            done < <(grep -v '^#' "${LISTS_DIR}/allowed-files.txt" 2>/dev/null || echo "")

            # Or check if it's in an allowed phrase
            if [ $IS_ALLOWED -eq 0 ]; then
                while IFS= read -r phrase; do
                    [ -z "$phrase" ] && continue
                    if git diff-index --cached -p HEAD -- | grep "^[+-]" | grep -qi "$phrase"; then
                        IS_ALLOWED=1
                        break
                    fi
                done < <(grep -v '^#' "${LISTS_DIR}/allowed-phrases.txt" 2>/dev/null || echo "")
            fi

            if [ $IS_ALLOWED -eq 0 ]; then
                error "Real company name found in source code diff: '$company'"
                error "  Company names should only appear in tests/docs/examples"
            fi
        fi
    done <<< "$COMPANIES"
fi

# ============================================================================
# 4. Check for real-world data patterns
# ============================================================================

# IBAN pattern (2 letters + 2 digits + up to 30 alphanumeric)
if git diff-index --cached -p HEAD -- 2>/dev/null | \
   grep -qiE "^[+-].*\b[A-Z]{2}[0-9]{2}[A-Z0-9]{4}[0-9]{7}([A-Z0-9]?){0,16}\b"; then
    error "Possible IBAN number found in diff (real bank account identifier)"
fi

# Credit card pattern (16 digits, possibly with spaces/dashes)
if git diff-index --cached -p HEAD -- 2>/dev/null | \
   grep -qE "^[+-].*\b([0-9]{4}[- ]?){3}[0-9]{4}\b"; then
    error "Possible credit card number found in diff (16-digit pattern)"
fi

# VIN pattern (17 characters, specific format)
if git diff-index --cached -p HEAD -- 2>/dev/null | \
   grep -qiE "^[+-].*\b[A-HJ-NPR-Z0-9]{17}\b"; then
    # This is a weak check, only warn
    warn "Found 17-char string that could be a VIN (vehicle ID number)"
fi

# International tracking number pattern (UPU S10: 2 letters + 9 digits + country code)
if git diff-index --cached -p HEAD -- 2>/dev/null | \
   grep -qiE "^[+-].*(LT|RZ|XX)[0-9]{9}[A-Z]{2}\b"; then
    error "Possible international tracking number found (UPU S10 format)"
fi

# Phone number pattern (+country_code digits)
if git diff-index --cached -p HEAD -- 2>/dev/null | \
   grep -qE "^[+-].*\+[1-9][0-9]{7,14}\b"; then
    error "Possible real phone number found (+ with 7-15 digits)"
fi

# ============================================================================
# 5. Final verdict
# ============================================================================

if [ $FOUND_ISSUES -eq 0 ]; then
    success "Pre-commit checks passed"
    exit 0
else
    echo ""
    echo -e "${RED}========================================${NC}"
    echo -e "${RED}Commit was blocked due to security checks${NC}"
    echo -e "${RED}========================================${NC}"
    echo ""
    echo "To override this check (use with extreme caution):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi
