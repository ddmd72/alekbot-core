# Coverage configuration for pytest-cov.
#
# Per-file coverage thresholds are enforced by
# scripts/check_coverage_thresholds.py (run via `make test-coverage` and `make ci`), and per-layer floors by
# scripts/check_coverage_layers.py, not by coverage.py itself — coverage.py only supports a single global
# fail_under. The thresholds mirror the mandate in
# docs/10_rfcs/NOTIFICATION_DELIVERY_REFACTOR_RFC.md § 8.4.

[run]
# `source` is read when the Makefile passes a bare `--cov` (a `--cov=src` on the command line would replace it).
# src is a directory; the root entry points are importable modules, measured when a test imports them. One no test
# imports (none today; main was one until P9) is not in the data at all: scripts/check_coverage_layers.py counts it as 0 %
# from its source.
# Branch coverage is on (P2): the layer floors and the global --cov-fail-under use the branch-aware percentage.
source =
    src
    main
    relay_main
    indexer_main
    sandbox_main
    job_main
branch = True
# Subprocess coverage (coverage >= 7.10): Python children that inherit the environment write their own data files,
# combined at the end; coverage ships the `a1_coverage.pth` hook, so nothing is written at run time. It measures the
# sandbox supervisor-test children (sandbox_main 33.8 -> 49.2 %). Limits: the drive parser and the sandbox engine start
# with an allowlisted environment (the parser also `-E -s`), so they are never measured, whatever the uid; a child with
# a scrubbed environment or `-S` is not measured; a child killed mid-write loses its data (a partial .coverage.* file).
patch = subprocess
omit =
    src/__init__.py
    */__pycache__/*
    */src/utils/telemetry.py
    */src/utils/server.py

[report]
# Hide trivial omissions; missing lines surface via --cov-report=term-missing.
# The last pattern is a line that is only `...` (a stub body). It is anchored: the unanchored `\.\.\.` it replaced also
# matched a `def` whose signature holds `...` (`Callable[..., Awaitable]`), and coverage then excluded that whole
# function (P7 finding F1).
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if TYPE_CHECKING:
    if __name__ == .__main__.:
    ^\s*\.\.\.\s*$

# Without this, coverage.py lists only the src/ subpackages that carry an __init__.py, and a file nobody imported is
# absent from the report instead of showing 0 % (src/ and most of its subdirectories are namespace packages).
include_namespace_packages = True

[json]
# scripts/check_coverage_thresholds.py reads this file.
output = coverage.json
pretty_print = False
